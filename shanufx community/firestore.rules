rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && getUserRole() in ['primary', 'admin'];
    }

    // Users
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Channels
    match /channels/{channelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Post votes
    match /postVotes/{voteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Invite tokens
    match /inviteTokens/{token} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isSignedIn(); // claim a token
      allow delete: if isAdmin();
    }

    // Site settings
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{id} {
      allow read, update, delete: if isSignedIn() && (resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn();
    }
  }
}
